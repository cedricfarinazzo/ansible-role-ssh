{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "description": "Consumer-facing collection ranges in requirements.yml stay ranges: widen, never pin",
      "matchManagers": [
        "ansible-galaxy"
      ],
      "rangeStrategy": "widen",
      "matchFileNames": [
        "requirements.yml"
      ]
    },
    {
      "description": "conventional-changelog-conventionalcommits 10 needs conventional-changelog-writer 9; @semantic-release/release-notes-generator 14 ships writer 8",
      "matchPackageNames": [
        "conventional-changelog-conventionalcommits"
      ],
      "allowedVersions": "<10"
    },
    {
      "description": "A pinned version in defaults/ or vars/ is what the role installs: its bump releases a fix",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "defaults/**",
        "vars/**"
      ],
      "semanticCommitType": "fix"
    },
    {
      "description": "A pinned version in molecule/ is a test pin: chore, no release; checksums next to it are updated by hand",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "molecule/**"
      ],
      "automerge": false,
      "prBodyNotes": [
        "Checksums pinned next to this version (archive and binary, per architecture) are not updated by Renovate: update them from the release before merging, or CI fails on the checksum check."
      ]
    }
  ],
  "ansible-galaxy": {
    "managerFilePatterns": [
      "/(^|/)(galaxy|requirements)(\\.ansible)?\\.ya?ml$/",
      "/(^|/)molecule/.+/collections\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "A version pinned in the role's sources, annotated on the line above: # renovate: datasource=<datasource> depName=<name> [extractVersion=<regex>]",
      "managerFilePatterns": [
        "/(^|/)(defaults|vars|molecule)/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s*\\n\\s*[A-Za-z0-9_]+: \"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{else}}^v?(?<version>.+)${{/if}}"
    }
  ]
}
