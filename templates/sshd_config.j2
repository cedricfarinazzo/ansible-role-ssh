# {{ ansible_managed }}
# sshd_config(5). sshd keeps the first value it reads for each directive.

{% if ssh_include_config_dir | bool %}
Include {{ ssh_config_dir }}/*.conf

{% endif %}
{% for port in [ssh_port] + openssh_extra_listen_ports | default([]) %}
Port {{ port }}
{% endfor %}

{% for host_key in ssh_host_keys %}
HostKey {{ host_key }}
{% endfor %}

# Cryptography (computed for OpenSSH {{ openssh_version }})
KexAlgorithms {{ ssh_kex_algorithms | join(',') }}
Ciphers {{ ssh_ciphers | join(',') }}
MACs {{ ssh_macs | join(',') }}
HostKeyAlgorithms {{ ssh_host_key_algorithms | join(',') }}
PubkeyAcceptedAlgorithms {{ ssh_pubkey_accepted_algorithms | join(',') }}
HostbasedAcceptedAlgorithms {{ ssh_hostbased_accepted_algorithms | join(',') }}
CASignatureAlgorithms {{ ssh_ca_signature_algorithms | join(',') }}
{% if openssh_supports_required_rsa_size %}
RequiredRSASize {{ ssh_required_rsa_size }}
{% endif %}
{% if openssh_supports_gssapi_kex and ssh_gssapi_kex_algorithms | length > 0 %}
GSSAPIKexAlgorithms {{ ssh_gssapi_kex_algorithms | join(',') }}
{% endif %}

# Logging
SyslogFacility {{ ssh_syslog_facility }}
LogLevel {{ ssh_log_level }}

# Authentication
LoginGraceTime {{ ssh_login_grace_time }}
PermitRootLogin {{ ssh_permit_root_login }}
StrictModes {{ ssh_strict_modes | bool | ternary('yes', 'no') }}
MaxAuthTries {{ ssh_max_auth_tries }}
MaxSessions {{ ssh_max_sessions }}
PubkeyAuthentication {{ ssh_pubkey_authentication | bool | ternary('yes', 'no') }}
AuthorizedKeysFile {{ ssh_authorized_keys_file }}
HostbasedAuthentication {{ ssh_hostbased_authentication | bool | ternary('yes', 'no') }}
IgnoreRhosts {{ ssh_ignore_rhosts | bool | ternary('yes', 'no') }}
PasswordAuthentication {{ ssh_password_authentication | bool | ternary('yes', 'no') }}
PermitEmptyPasswords {{ ssh_permit_empty_passwords | bool | ternary('yes', 'no') }}
KbdInteractiveAuthentication {{ ssh_kbd_interactive_authentication | bool | ternary('yes', 'no') }}
KerberosAuthentication {{ ssh_kerberos_authentication | bool | ternary('yes', 'no') }}
GSSAPIAuthentication {{ ssh_gssapi_authentication | bool | ternary('yes', 'no') }}
{% if ssh_authentication_methods %}
AuthenticationMethods {{ ssh_authentication_methods }}
{% endif %}
UsePAM {{ ssh_use_pam | bool | ternary('yes', 'no') }}
{% if ssh_allow_users | length > 0 %}
AllowUsers {{ ssh_allow_users | join(' ') }}
{% endif %}

# Forwarding and session features
AllowAgentForwarding {{ ssh_allow_agent_forwarding | bool | ternary('yes', 'no') }}
AllowTcpForwarding {{ ssh_allow_tcp_forwarding | bool | ternary('yes', 'no') }}
AllowStreamLocalForwarding {{ ssh_allow_stream_local_forwarding | bool | ternary('yes', 'no') }}
GatewayPorts {{ ssh_gateway_ports | bool | ternary('yes', 'no') }}
PermitTunnel {{ ssh_permit_tunnel | bool | ternary('yes', 'no') }}
X11Forwarding {{ ssh_x11_forwarding | bool | ternary('yes', 'no') }}
PermitUserEnvironment {{ ssh_permit_user_environment | bool | ternary('yes', 'no') }}
PrintMotd {{ ssh_print_motd | bool | ternary('yes', 'no') }}
Compression {{ ssh_compression | bool | ternary('yes', 'no') }}
AcceptEnv {{ ssh_accept_env }}

# Connections
ClientAliveCountMax {{ ssh_client_alive_count_max }}
ClientAliveInterval {{ ssh_client_alive_interval }}
MaxStartups {{ ssh_max_startups }}
{% if ssh_per_source_max_startups %}
PerSourceMaxStartups {{ ssh_per_source_max_startups }}
{% endif %}
{% if ssh_per_source_net_block_size %}
PerSourceNetBlockSize {{ ssh_per_source_net_block_size }}
{% endif %}
{% if openssh_supports_per_source_penalties and ssh_per_source_penalties %}
PerSourcePenalties {{ ssh_per_source_penalties }}
{% endif %}
{% if openssh_supports_per_source_penalties and ssh_per_source_penalty_exempt_list | length > 0 %}
PerSourcePenaltyExemptList {{ ssh_per_source_penalty_exempt_list | join(',') }}
{% endif %}
{% if openssh_supports_connection_timeouts and ssh_unused_connection_timeout %}
UnusedConnectionTimeout {{ ssh_unused_connection_timeout }}
{% endif %}
{% if openssh_supports_connection_timeouts and ssh_channel_timeout %}
ChannelTimeout {{ ssh_channel_timeout }}
{% endif %}

# Banner
Banner {{ ssh_banner }}
{% if ansible_facts['os_family'] == 'Debian' %}
# Debian-patched builds only; sshd elsewhere rejects the keyword
DebianBanner {{ ssh_debian_banner | bool | ternary('yes', 'no') }}
{% endif %}
{% if ssh_subsystem_sftp %}

Subsystem sftp {{ ssh_subsystem_sftp }}
{% endif %}
{% if ssh_additional_config | length > 0 %}

# Additional configuration
{% for config_line in ssh_additional_config %}
{{ config_line }}
{% endfor %}
{% endif %}
